{
  "name": "nighi-cafe",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "server": "npm run start --workspace backend",
    "dev:full": "concurrently \"npm run server\" \"npm run dev\"",
    "build": "npm run build --workspace frontend",
    "preview": "npm run preview --workspace frontend",
    "lint": "oxlint frontend/src backend",
    "test": "npm run test --workspace backend",
    "create-admin": "npm run create-admin --workspace backend"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "oxlint": "^1.89.0"
  }
}
