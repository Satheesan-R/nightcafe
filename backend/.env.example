MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/nighi_cafe
PORT=5000
# Optional absolute persistent disk path on Render, e.g. /var/data/uploads.
# Leave empty locally to use backend/uploads. Upload URLs remain /uploads/...
UPLOAD_DIR=
# Set all three on Render and locally to store new uploads in the same cloud.
# Leave all empty for disk uploads. Never put these in frontend/VITE_ variables.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Keep lax for same-site HTTPS domains or a same-origin /api proxy.
# For unrelated HTTPS frontend/API domains only: production + none.
COOKIE_SAME_SITE=lax
# Comma-separated IPs/CIDRs of actual trusted reverse proxies; empty for direct access.
# Do not set true or trust arbitrary client-supplied forwarded headers.
TRUST_PROXY=

# Used only by npm run create-admin. Remove ADMIN_PASSWORD after setup.
ADMIN_NAME=Cafe Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
